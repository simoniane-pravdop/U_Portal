PORTAL_BASE_URL=http://localhost:3000
# PBKDF2 records used only to initialize the two first portal accounts.
# Format: pbkdf2:<iterations>:<base64-salt>:<base64-hash>
PORTAL_OWNER_CREDENTIAL=
PORTAL_ADMIN_CREDENTIAL=
# Random 32-byte value kept only as a local/Cloudflare secret.
PORTAL_PASSWORD_PEPPER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
# Base64-encoded 32-byte key used to encrypt Asana tokens.
TOKEN_ENCRYPTION_KEY=
